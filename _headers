# Kopfzeilen fuer Cloudflare. GitHub Pages ignoriert diese Datei.

/*
  # Private Lernseiten gehoeren in keinen Suchindex.
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # Mikrofon fuer die Nachsprech-Uebungen erlauben (nur eigene Seite)
  Permissions-Policy: microphone=(self)
